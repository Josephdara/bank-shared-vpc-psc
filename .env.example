# Shared VPC + PSC bootstrap configuration — copy to .env and fill in real values:
#   cp .env.example .env
# .env is gitignored (holds org/billing identifiers); this template is safe to commit.
# Blank derivable values (suffix, project IDs, state bucket) are generated on first run.

# ---- Organization & billing (required) ----
ORG_ID=                 # numeric org ID, e.g. 123456789012
FOLDER_ID=              # optional: existing folder to use. If blank and ORG_ID is set,
                        # bootstrap creates a folder named FOLDER_NAME and fills this in.
FOLDER_NAME=shared-vpc-psc  # display name for the folder bootstrap creates under the org
BILLING_ACCOUNT_ID=     # e.g. 0X0X0X-0X0X0X-0X0X0X

# ---- Naming ----
# Project IDs are built as <PROJECT_PREFIX>-<role>-<PROJECT_SUFFIX> and are globally unique.
# Leave PROJECT_SUFFIX blank to auto-generate a stable one on first run.
PROJECT_PREFIX=svpc-psc
PROJECT_SUFFIX=

# ---- Project IDs (leave blank to derive from prefix + suffix) ----
HOST_PROJECT_ID=
SERVICE_A_PROJECT_ID=
SERVICE_B_PROJECT_ID=
PARTNER_PROJECT_ID=

# ---- Location ----
# Deployment regions are set in terraform/ (terraform.tfvars), not here.
LOCATION=US             # Terraform state bucket location (region or multi-region)

# ---- Terraform ----
TF_STATE_BUCKET=        # leave blank to derive as <HOST_PROJECT_ID>-tfstate
TERRAFORM_DIR=terraform
